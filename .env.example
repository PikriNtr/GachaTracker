# Discord Bot Token
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Server (Guild) IDs for instant slash command sync (comma-separated for multiple)
GUILD_ID=

# Optional: Voice Channel ID for 24/7 staying (comma-separated for multiple)
VOICE_CHANNEL_ID=

# REST API (Phase 11)
# Key for write endpoints (import/delete) - generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Set to 1 to require the key on READ endpoints too (default: reads are open)
API_REQUIRE_KEY_FOR_READS=
